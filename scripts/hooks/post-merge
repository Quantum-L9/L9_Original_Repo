#!/usr/bin/env bash
# =============================================================================
# L9 POST-MERGE HOOK v2.0 — FRONTIER AI LAB PRODUCTION STANDARD
# =============================================================================
# Author: L9 Engineering (via AI Agent)
# Date:   2026-02-16
# Drop into .git/hooks/post-merge and chmod +x
# Compliance: ShellCheck SC0-level
# Risk Tier: T2 (auto-sync on pull)
#
# CHANGES FROM v1.0:
# - ShellCheck clean (printf, quoted vars, local declarations)
# - Migration gate → advisory only (no auto-execution) — per risk tiering
# - Hook versioning with self-update detection
# - Trap-based cleanup
# =============================================================================

HOOK_VERSION="2.0.0"
set -euo pipefail
IFS=$'\n\t'

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m'

# Paths
readonly REPO_ROOT="$(git rev-parse --show-toplevel)"

printf "%b🔄 L9 Post-Merge Automation v%s%b\n" "$BLUE" "$HOOK_VERSION" "$NC"
printf "========================================\n"

# Get changed files between previous HEAD and current HEAD
CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)

if [ -z "$CHANGED_FILES" ]; then
    printf "%b✓ No changes detected%b\n" "$GREEN" "$NC"
    exit 0
fi

# ============================================
# 0. HOOK VERSION CHECK (self-update)
# ============================================
printf "\n%b[0/9]%b Checking hook versions...\n" "$YELLOW" "$NC"

CANONICAL_VERSION_FILE="$REPO_ROOT/scripts/hooks/.version"
INSTALLED_VERSION_FILE="$REPO_ROOT/.git/hooks/.installed_version"

if [ -f "$CANONICAL_VERSION_FILE" ]; then
    CANONICAL_VERSION=$(cat "$CANONICAL_VERSION_FILE")
    INSTALLED_VERSION=""
    if [ -f "$INSTALLED_VERSION_FILE" ]; then
        INSTALLED_VERSION=$(cat "$INSTALLED_VERSION_FILE")
    fi

    if [ "$CANONICAL_VERSION" != "$INSTALLED_VERSION" ]; then
        printf "%b⚠ Hooks are outdated! Installed: %s, Repo: %s%b\n" "$YELLOW" "${INSTALLED_VERSION:-none}" "$CANONICAL_VERSION" "$NC"
        if [ -f "$REPO_ROOT/scripts/hooks/install-hooks.sh" ]; then
            printf "  Auto-reinstalling hooks...\n"
            bash "$REPO_ROOT/scripts/hooks/install-hooks.sh" || {
                printf "%b⚠ Auto-reinstall failed. Run manually: bash scripts/hooks/install-hooks.sh%b\n" "$YELLOW" "$NC"
            }
        else
            printf "  Run: bash scripts/hooks/install-hooks.sh\n"
        fi
    else
        printf "%b✓ Hooks are up to date (v%s)%b\n" "$GREEN" "$CANONICAL_VERSION" "$NC"
    fi
else
    printf "%b✓ No version file found (skipping)%b\n" "$GREEN" "$NC"
fi

# ============================================
# 1. ENVIRONMENT VARIABLES SYNC
# ============================================
printf "\n%b[1/9]%b Checking environment variables...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -q "^\.env\.example$"; then
    printf "%b⚠ .env.example changed!%b\n" "$YELLOW" "$NC"
    if [ -f ".env.example" ] && [ -f ".env" ]; then
        NEW_VARS=$(comm -23 <(grep "^[A-Z]" .env.example | cut -d= -f1 | sort) <(grep "^[A-Z]" .env | cut -d= -f1 | sort) || true)
        if [ -n "$NEW_VARS" ]; then
            printf "%b❌ Missing environment variables:%b\n" "$RED" "$NC"
            echo "$NEW_VARS" | while IFS= read -r var; do
                printf "  - %s\n" "$var"
            done
            printf "\nAction required:\n"
            printf "  1. Copy missing vars from .env.example to .env\n"
            printf "  2. Set appropriate values\n"
        else
            printf "%b✓ All required env vars present%b\n" "$GREEN" "$NC"
        fi
    fi
else
    printf "%b✓ No env changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# 2. PYTHON DEPENDENCIES
# ============================================
printf "\n%b[2/9]%b Checking Python dependencies...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -qE "^(requirements\.txt|pyproject\.toml|setup\.py)$"; then
    printf "%b⚠ Dependencies changed!%b\n" "$YELLOW" "$NC"
    printf "  Auto-installing...\n"
    if [ -f "requirements.txt" ]; then
        pip install -r requirements.txt --quiet 2>&1 | tail -5 || true
    elif [ -f "pyproject.toml" ]; then
        pip install -e . --quiet 2>&1 | tail -5 || true
    fi
    printf "%b✓ Dependencies installed%b\n" "$GREEN" "$NC"
else
    printf "%b✓ No dependency changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# 3. DATABASE MIGRATIONS (ADVISORY ONLY — T3 risk)
# ============================================
printf "\n%b[3/9]%b Checking for new migrations...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -q "^migrations/.*\.sql$"; then
    NEW_MIGRATIONS=$(echo "$CHANGED_FILES" | grep "^migrations/.*\.sql$" || true)
    printf "%b⚠ New migrations detected:%b\n" "$YELLOW" "$NC"
    echo "$NEW_MIGRATIONS" | while IFS= read -r migration; do
        printf "  - %s\n" "$migration"
    done
    printf "\n%b  ⚠ ADVISORY: Migrations require manual execution (T3 risk)%b\n" "$YELLOW" "$NC"
    printf "  Run:\n"
    printf "    python3 -c \"from memory.migration_runner import run_migrations; import asyncio; asyncio.run(run_migrations())\"\n"
    printf "  Or:\n"
    printf "    make migrate\n\n"
else
    printf "%b✓ No new migrations%b\n" "$GREEN" "$NC"
fi

# ============================================
# 4. DOCKER CHANGES
# ============================================
printf "\n%b[4/9]%b Checking Docker configuration...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -qE "^(Dockerfile|docker-compose\.yml|\.dockerignore)$"; then
    printf "%b⚠ Docker configuration changed!%b\n" "$YELLOW" "$NC"
    printf "\n  Action required:\n"
    printf "    docker-compose down\n"
    printf "    docker-compose up --build -d\n\n"
else
    printf "%b✓ No Docker changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# 5. KERNEL HOT-RELOAD
# ============================================
printf "\n%b[5/9]%b Checking kernel changes...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -q "^kernels/"; then
    printf "%b⚠ Kernels changed!%b\n" "$YELLOW" "$NC"
    if curl -s -X POST http://localhost:8000/api/kernels/reload --max-time 2 >/dev/null 2>&1; then
        printf "%b✓ Kernels hot-reloaded%b\n" "$GREEN" "$NC"
    else
        printf "%b  (Server not running — kernels will reload on next startup)%b\n" "$YELLOW" "$NC"
    fi
else
    printf "%b✓ No kernel changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# 6. AUDIT CACHE INVALIDATION
# ============================================
printf "\n%b[6/9]%b Checking audit scripts...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -q "^scripts/audit/"; then
    printf "%b⚠ Audit scripts changed!%b\n" "$YELLOW" "$NC"
    if [ -d ".audit_cache" ]; then
        printf "  Clearing audit cache...\n"
        rm -rf .audit_cache/
        printf "%b✓ Cache cleared%b\n" "$GREEN" "$NC"
    else
        printf "%b✓ No cache to clear%b\n" "$GREEN" "$NC"
    fi
else
    printf "%b✓ No audit script changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# 7. PRE-COMMIT CONFIG UPDATE
# ============================================
printf "\n%b[7/9]%b Checking pre-commit configuration...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -q "^\.pre-commit-config\.yaml$"; then
    printf "%b⚠ Pre-commit config changed!%b\n" "$YELLOW" "$NC"
    if command -v pre-commit &> /dev/null; then
        printf "  Reinstalling hooks...\n"
        pre-commit install --install-hooks >/dev/null 2>&1 || true
        printf "%b✓ Hooks updated%b\n" "$GREEN" "$NC"
    else
        printf "%b  Install pre-commit: pip install pre-commit%b\n" "$YELLOW" "$NC"
    fi
else
    printf "%b✓ No pre-commit changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# 8. REPO INDEX REGENERATION
# ============================================
printf "\n%b[8/9]%b Checking repo index...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -qE "\.(py|md|yaml)$"; then
    if [ -f "scripts/generate_repo_index.py" ]; then
        printf "  Regenerating repo index (background)...\n"
        nohup python3 scripts/generate_repo_index.py --quiet >/dev/null 2>&1 &
        printf "%b✓ Index regeneration started%b\n" "$GREEN" "$NC"
    else
        printf "%b✓ No index generator found%b\n" "$GREEN" "$NC"
    fi
else
    printf "%b✓ No index regeneration needed%b\n" "$GREEN" "$NC"
fi

# ============================================
# 9. DEPENDENCY LOCKFILE VALIDATION
# ============================================
printf "\n%b[9/9]%b Checking lockfile integrity...\n" "$YELLOW" "$NC"

if echo "$CHANGED_FILES" | grep -qE "^(requirements\.txt|pyproject\.toml)$"; then
    if [ -f "requirements.txt" ] && [ -f "requirements.lock" ]; then
        CURRENT_HASH=$(sha256sum requirements.txt | cut -d' ' -f1)
        LOCK_HASH=$(head -1 requirements.lock 2>/dev/null | grep -oP '(?<=hash:)[a-f0-9]+' || echo "none")
        if [ "$CURRENT_HASH" != "$LOCK_HASH" ]; then
            printf "%b⚠ requirements.txt changed but lockfile hash mismatch%b\n" "$YELLOW" "$NC"
            printf "  Run: make lock-deps\n"
        else
            printf "%b✓ Lockfile matches%b\n" "$GREEN" "$NC"
        fi
    else
        printf "%b✓ No lockfile to validate%b\n" "$GREEN" "$NC"
    fi
else
    printf "%b✓ No dependency file changes%b\n" "$GREEN" "$NC"
fi

# ============================================
# SUCCESS
# ============================================
printf "\n%b✅ Post-merge automation complete!%b\n" "$GREEN" "$NC"
printf "========================================\n"
