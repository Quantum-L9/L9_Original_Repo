#!/usr/bin/env bash
# =============================================================================
# L9 COMMIT-MSG HOOK v2.0 — CONVENTIONAL COMMITS ENFORCEMENT
# =============================================================================
# Author: L9 Engineering (via AI Agent)
# Date:   2026-02-16
# Drop into .git/hooks/commit-msg and chmod +x
# Compliance: ShellCheck SC0-level
# Risk Tier: T1 (read-only validation)
#
# Enforces Conventional Commits: https://www.conventionalcommits.org
# Format: <type>(<scope>): <subject>
# Allowed types: feat, fix, chore, docs, style, refactor, perf, test, ci, build, revert
# Also allows: Merge commits, fixup!, squash!
# =============================================================================

HOOK_VERSION="2.0.0"
set -euo pipefail

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

COMMIT_MSG_FILE="$1"

if [ ! -f "$COMMIT_MSG_FILE" ]; then
    printf "%b❌ commit-msg hook: No commit message file found%b\n" "$RED" "$NC" >&2
    exit 1
fi

COMMIT_MSG=$(head -1 "$COMMIT_MSG_FILE")

# Skip validation for merge commits
if echo "$COMMIT_MSG" | grep -qE "^Merge (branch|pull request|remote-tracking)"; then
    exit 0
fi

# Skip validation for fixup/squash commits (used in interactive rebase)
if echo "$COMMIT_MSG" | grep -qE "^(fixup!|squash!|amend!)"; then
    exit 0
fi

# Skip validation for revert commits auto-generated by git
if echo "$COMMIT_MSG" | grep -qE "^Revert \""; then
    exit 0
fi

# Conventional Commits regex
# Format: type(scope): subject  OR  type: subject
# Types: feat|fix|chore|docs|style|refactor|perf|test|ci|build|revert
CONVENTIONAL_REGEX="^(feat|fix|chore|docs|style|refactor|perf|test|ci|build|revert)(\([a-zA-Z0-9_.-]+\))?!?: .{1,100}$"

if ! echo "$COMMIT_MSG" | grep -qE "$CONVENTIONAL_REGEX"; then
    printf "\n%b❌ COMMIT MESSAGE REJECTED%b\n" "$RED" "$NC" >&2
    printf "========================================\n" >&2
    printf "Your message: %s\n\n" "$COMMIT_MSG" >&2
    printf "Expected format:\n" >&2
    printf "  %b<type>(<scope>): <subject>%b\n\n" "$YELLOW" "$NC" >&2
    printf "Allowed types:\n" >&2
    printf "  feat, fix, chore, docs, style, refactor,\n" >&2
    printf "  perf, test, ci, build, revert\n\n" >&2
    printf "Examples:\n" >&2
    printf "  feat(memory): add substrate versioning\n" >&2
    printf "  fix(kernels): resolve hot-reload race condition\n" >&2
    printf "  chore: update dependencies\n" >&2
    printf "  feat!: breaking change to PacketEnvelope\n\n" >&2
    printf "To bypass (NOT recommended): git commit --no-verify\n" >&2
    printf "========================================\n" >&2
    exit 1
fi

# Validate subject line length (max 100 chars)
SUBJECT_LENGTH=${#COMMIT_MSG}
if [ "$SUBJECT_LENGTH" -gt 100 ]; then
    printf "%b⚠ Subject line too long (%d chars, max 100)%b\n" "$YELLOW" "$SUBJECT_LENGTH" "$NC" >&2
    printf "  Consider moving details to the commit body.\n" >&2
    # Warning only, not blocking
fi

# Check for BREAKING CHANGE footer in multi-line commits
if [ "$(wc -l < "$COMMIT_MSG_FILE")" -gt 1 ]; then
    if grep -q "^BREAKING CHANGE:" "$COMMIT_MSG_FILE" 2>/dev/null; then
        if ! echo "$COMMIT_MSG" | grep -q "!:"; then
            printf "%b⚠ BREAKING CHANGE footer found but no '!' in type.%b\n" "$YELLOW" "$NC" >&2
            printf "  Recommended: feat!: or fix!: for breaking changes\n" >&2
        fi
    fi
fi

# Extract ticket number from branch and append if missing
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
TICKET=$(echo "$BRANCH" | grep -oE "L9-[0-9]+" || true)

if [ -n "$TICKET" ] && ! grep -q "$TICKET" "$COMMIT_MSG_FILE" 2>/dev/null; then
    # Append ticket reference to commit body
    printf "\n\nRefs: %s" "$TICKET" >> "$COMMIT_MSG_FILE"
fi

printf "%b✓ Commit message valid (Conventional Commits)%b\n" "$GREEN" "$NC"
exit 0
