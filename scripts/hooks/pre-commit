#!/usr/bin/env bash
# L9 PRE-COMMIT HOOK - PRODUCTION GRADE
# Frontier AI Lab Standard (Anthropic/OpenAI tier)
# Gap Closures: Branch Protection, AI Security, Test Execution, Audit Logging, Protected Surfaces
# Date: 2026-01-19 | Risk Tier: T2

set -e

# ============================================
# CONFIGURATION & INITIALIZATION
# ============================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)
HOOK_DIR="$REPO_ROOT/.git/hooks"
LIB_DIR="$HOOK_DIR/lib"
BRANCH=$(git rev-parse --abbrev-ref HEAD)
USER=$(git config user.name)
EMAIL=$(git config user.email)

# Logging paths (use ~/.l9/logs - no sudo required)
L9_LOG_DIR="${L9_LOG_DIR:-$HOME/.l9/logs}"
HOOK_AUDIT_LOG="${HOOK_AUDIT_LOG:-$L9_LOG_DIR/pre-commit-hooks.jsonl}"
AI_SEC_LOG="${AI_SEC_LOG:-$L9_LOG_DIR/ai_security.jsonl}"
TEST_LOG="${TEST_LOG:-$L9_LOG_DIR/test_execution.jsonl}"

# Create log directories
mkdir -p "$L9_LOG_DIR" 2>/dev/null || true

# Metrics
HOOK_START=$(date +%s)
TOTAL_CHECKS=11
CHECKS_PASSED=0

# Get staged Python files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

echo -e "${BLUE}🔐 L9 ENTERPRISE PRE-COMMIT SECURITY GATES${NC}"
echo "=========================================="
echo -e "Branch: ${YELLOW}$BRANCH${NC} | User: ${YELLOW}$USER${NC}"
echo "Staged files: $(echo $STAGED_PY_FILES | wc -w) Python modules"
echo "=========================================="

# ============================================
# PHASE 0: BRANCH PROTECTION (NO BYPASS ON MAIN)
# ============================================

echo -e "\n${YELLOW}[GATE 0/9]${NC} BRANCH PROTECTION CHECK"

PROTECTED_BRANCHES=("main" "production" "release/.*" "master")
BYPASS_BLOCKED=0

for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$BRANCH" =~ ^${protected}$ ]]; then
        # Strict enforcement: no --no-verify allowed
        if env | grep -q "GIT_SKIP_HOOKS\|SKIP_PRECOMMIT" || [[ "$@" == *"--no-verify"* ]]; then
            echo -e "${RED}❌ CRITICAL: --no-verify / bypass blocked on $BRANCH${NC}"
            echo "   Branch: $BRANCH is PROTECTED"
            echo "   Emergency override: Contact security@l9.ai with incident ticket"

            # Log to audit trail
            echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"bypass_attempt_blocked\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"severity\":\"CRITICAL\"}" >> "$HOOK_AUDIT_LOG"

            BYPASS_BLOCKED=1
        fi
    fi
done

if [ $BYPASS_BLOCKED -eq 1 ]; then
    exit 1
fi

echo -e "${GREEN}✓ Branch protection verified (main branch bypass impossible)${NC}"
CHECKS_PASSED=$((CHECKS_PASSED + 1))

# ============================================
# PHASE 1: SECRET SCANNING (ALL FILE TYPES)
# ============================================

echo -e "\n${YELLOW}[GATE 1/9]${NC} SECRET SCANNING"

# Get ALL staged files (not just Python) - secrets can be anywhere
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ No files staged, skipping secret scan${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    if command -v gitleaks &> /dev/null; then
        # Use --config if .gitleaks.toml exists
        GITLEAKS_CONFIG=""
        if [ -f "$REPO_ROOT/.gitleaks.toml" ]; then
            GITLEAKS_CONFIG="--config=$REPO_ROOT/.gitleaks.toml"
        fi

        if gitleaks protect --staged --no-banner $GITLEAKS_CONFIG 2>/dev/null; then
            echo -e "${GREEN}✓ No secrets detected ($(echo $STAGED_FILES | wc -w | tr -d ' ') files scanned)${NC}"
            CHECKS_PASSED=$((CHECKS_PASSED + 1))
        else
            GITLEAKS_EXIT=$?
            if [ $GITLEAKS_EXIT -eq 1 ]; then
                echo -e "${RED}❌ SECRETS DETECTED IN STAGED FILES${NC}"
                echo -e "${RED}   Run: gitleaks protect --staged -v for details${NC}"
                echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"secrets_detected\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"severity\":\"CRITICAL\"}" >> "$HOOK_AUDIT_LOG"
                exit 1
            fi
        fi
    else
        echo -e "${YELLOW}⚠ gitleaks not installed, install: brew install gitleaks${NC}"
    fi
fi

# ============================================
# PHASE 1B: HARDCODED CREDENTIALS CHECK (ADR-0090)
# ============================================
# NOTE: Only checks STAGED files, not whole repo (full repo audit is CI's job)

echo -e "\n${YELLOW}[GATE 1B]${NC} HARDCODED CREDENTIALS CHECK (ADR-0090)"

CRED_VIOLATIONS=0

# Get all staged files (not just Python)
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -n "$STAGED_ALL" ]; then
    # Exclude ADR/documentation files from credentials check (they contain examples)
    STAGED_NON_DOC=$(echo "$STAGED_ALL" | grep -v 'readme/adr/' | grep -v '\.md$' || true)

    # AWS Access Keys (always critical) - only in staged non-doc files
    FOUND=$(echo "$STAGED_NON_DOC" | xargs grep -E "AKIA[0-9A-Z]{16}" 2>/dev/null | grep -v '\.env' || true)

    if [ -n "$FOUND" ]; then
        echo -e "${RED}❌ AWS ACCESS KEYS DETECTED:${NC}"
        echo "$FOUND"
        CRED_VIOLATIONS=$((CRED_VIOLATIONS + 1))
    fi

    # API keys (64-char hex) - only in staged non-doc files
    FOUND=$(echo "$STAGED_NON_DOC" | xargs grep -E '(API_KEY|api_key|L9_API_KEY).*"[a-f0-9]{64}"' 2>/dev/null | grep -v '\.env' || true)

    if [ -n "$FOUND" ]; then
        echo -e "${RED}❌ HARDCODED API KEYS:${NC}"
        echo "$FOUND"
        CRED_VIOLATIONS=$((CRED_VIOLATIONS + 1))
    fi

    # PostgreSQL with real passwords - only in staged non-doc files
    FOUND=$(echo "$STAGED_NON_DOC" | xargs grep -E 'postgresql://.*:.*@' 2>/dev/null \
      | grep -v '\.env' \
      | grep -v 'user:pass@' | grep -v 'user:password@' | grep -v 'postgres:postgres@' \
      | grep -v 'test:test@' | grep -v 'l9:l9test@' \
      | grep -v '\$(' | grep -v '\${' | grep -v '\$[A-Z]' \
      | grep -v ':PASSWORD@' | grep -v ':password@' | grep -v ':devpass@' \
      | grep -v 'POSTGRES_PASSWORD@' | grep -v '\.\.\.' | grep -v '\*\*\*' || true)

    if [ -n "$FOUND" ]; then
        echo -e "${RED}❌ HARDCODED POSTGRES CREDENTIALS:${NC}"
        echo "$FOUND"
        CRED_VIOLATIONS=$((CRED_VIOLATIONS + 1))
    fi
fi

if [ $CRED_VIOLATIONS -gt 0 ]; then
    echo -e "${RED}❌ Found hardcoded credentials (ADR-0090 violation)${NC}"
    echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"hardcoded_credentials\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"severity\":\"CRITICAL\"}" >> "$HOOK_AUDIT_LOG"
    exit 1
fi

echo -e "${GREEN}✓ No hardcoded credentials found (ADR-0090)${NC}"
CHECKS_PASSED=$((CHECKS_PASSED + 1))

# ============================================
# PHASE 2: AUTO-FORMAT PYTHON
# ============================================

echo -e "\n${YELLOW}[GATE 2/9]${NC} AUTO-FORMAT PYTHON (ruff)"

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files to format${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    if command -v ruff &> /dev/null; then
        echo "$STAGED_PY_FILES" | xargs ruff format --quiet 2>/dev/null || true
        # Only re-add files that are not gitignored
        for f in $STAGED_PY_FILES; do
            if ! git check-ignore -q "$f" 2>/dev/null; then
                git add "$f" 2>/dev/null || true
            fi
        done
        echo -e "${GREEN}✓ Code formatted with ruff${NC}"
        CHECKS_PASSED=$((CHECKS_PASSED + 1))
    else
        echo -e "${YELLOW}⚠ ruff not installed, install: pip install ruff${NC}"
    fi
fi

# ============================================
# PHASE 3: LINT PYTHON
# ============================================

echo -e "\n${YELLOW}[GATE 3/9]${NC} LINT PYTHON (ruff check)"

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files to lint${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    if command -v ruff &> /dev/null; then
        if echo "$STAGED_PY_FILES" | xargs ruff check --fix --exit-zero 2>/dev/null; then
            echo "$STAGED_PY_FILES" | xargs git add
            echo -e "${GREEN}✓ Lint checks passed (auto-fixed)${NC}"
            CHECKS_PASSED=$((CHECKS_PASSED + 1))
        else
            echo -e "${RED}❌ Lint errors found${NC}"
            echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"lint_failed\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"severity\":\"HIGH\"}" >> "$HOOK_AUDIT_LOG"
            exit 1
        fi
    fi
fi

# ============================================
# PHASE 4: TYPE CHECKING (WARN ONLY - Strict mode in CI)
# ============================================

echo -e "\n${YELLOW}[GATE 4/9]${NC} TYPE CHECKING (quick check)"

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files to type-check${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    if ! command -v mypy &> /dev/null; then
        echo -e "${YELLOW}⚠ mypy not installed (pip install mypy) - skipping${NC}"
        CHECKS_PASSED=$((CHECKS_PASSED + 1))
    else
        # Quick type check (non-strict, non-blocking) - strict mode runs in CI
        MYPY_START=$(date +%s%3N)
        if echo "$STAGED_PY_FILES" | xargs mypy --ignore-missing-imports --no-error-summary 2>&1 | head -10; then
            MYPY_END=$(date +%s%3N)
            MYPY_MS=$((MYPY_END - MYPY_START))
            echo -e "${GREEN}✓ Type check passed (${MYPY_MS}ms) - strict mode enforced in CI${NC}"
            CHECKS_PASSED=$((CHECKS_PASSED + 1))
        else
            MYPY_END=$(date +%s%3N)
            MYPY_MS=$((MYPY_END - MYPY_START))
            echo -e "${YELLOW}⚠ Type warnings found (${MYPY_MS}ms) - will be enforced in CI${NC}"
            echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"type_check_warnings\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"severity\":\"LOW\"}" >> "$HOOK_AUDIT_LOG"
            CHECKS_PASSED=$((CHECKS_PASSED + 1))  # Don't block, just warn
        fi
    fi
fi

# ============================================
# PHASE 5: AI SECURITY VALIDATION
# ============================================

echo -e "\n${YELLOW}[GATE 5/9]${NC} AI SECURITY (PROMPT INJECTION DETECTION)"

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files to validate for AI threats${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    AI_VIOLATIONS=0

    # Check for jailbreak patterns
    # Note: system_prompt constant definitions are safe (UPPERCASE_NAME = """...""")
    # We only flag dynamic/runtime injection patterns, not static definitions
    JAILBREAK_PATTERNS=(
        "Ignore.*previous.*instructions"
        "Disregard.*above.*instructions"
        "Forget.*the.*system.*prompt"
        "Pretend.*you.*are"
        "override.*safety"
        "bypass.*restrictions"
        "system_prompt\s*=.*\{.*\}"          # f-string injection into system_prompt
        "system_prompt\s*=.*\.format\s*\("   # .format() injection into system_prompt
        "system_prompt\s*\+=\s*"             # appending to system_prompt
    )

    for file in $STAGED_PY_FILES; do
        for pattern in "${JAILBREAK_PATTERNS[@]}"; do
            if grep -inE "$pattern" "$file" 2>/dev/null | grep -v "# security test" > /dev/null; then
                echo "   ⚠️  Potential prompt injection in: $file"
                AI_VIOLATIONS=$((AI_VIOLATIONS + 1))
                echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"ai_injection_detected\",\"file\":\"$file\",\"pattern\":\"$pattern\",\"severity\":\"HIGH\"}" >> "$AI_SEC_LOG"
            fi
        done

        # Check PacketEnvelope safety - look for actual dangerous Python functions
        # Avoid false positives: method definitions, docker exec, "# security test" comments
        if grep -q "PacketEnvelope" "$file" 2>/dev/null; then
            # Look for dangerous patterns but exclude method defs and security test comments
            if grep -E "pickle\.(load|loads)|[^f]eval\(|[^d]exec\(|__import__" "$file" 2>/dev/null \
              | grep -v "# security test" \
              | grep -v "def compile\|async def compile" > /dev/null 2>&1; then
                echo "   ❌ Unsafe deserialization in PacketEnvelope: $file"
                AI_VIOLATIONS=$((AI_VIOLATIONS + 1))
                echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"unsafe_serialization\",\"file\":\"$file\",\"severity\":\"CRITICAL\"}" >> "$AI_SEC_LOG"
            fi
        fi

        # Check WebSocket message validation
        if [[ "$file" == *websocket* ]] || [[ "$file" == *ws_* ]]; then
            if grep -q "json.loads\|yaml.load" "$file" 2>/dev/null && ! grep -q "validate\|schema" "$file"; then
                echo "   ⚠️  WebSocket messages may lack validation: $file"
                AI_VIOLATIONS=$((AI_VIOLATIONS + 1))
                echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"missing_ws_validation\",\"file\":\"$file\",\"severity\":\"HIGH\"}" >> "$AI_SEC_LOG"
            fi
        fi
    done

    if [ $AI_VIOLATIONS -gt 0 ]; then
        echo -e "${RED}❌ Found $AI_VIOLATIONS AI security issues${NC}"
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"ai_security_check_failed\",\"violations\":$AI_VIOLATIONS,\"severity\":\"HIGH\"}" >> "$HOOK_AUDIT_LOG"
        exit 1
    fi

    echo -e "${GREEN}✓ AI security checks passed (no injection patterns)${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# ============================================
# PHASE 6: TEST EXECUTION + COVERAGE
# ============================================

echo -e "\n${YELLOW}[GATE 6/9]${NC} TEST EXECUTION + COVERAGE (≥75%)"

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files to test${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    if ! command -v pytest &> /dev/null; then
        echo -e "${YELLOW}⚠ pytest not installed, skipping tests (pip install pytest pytest-cov)${NC}"
        CHECKS_PASSED=$((CHECKS_PASSED + 1))
    else
        # Extract module paths and run focused tests
        MODULES=$(echo "$STAGED_PY_FILES" | sed 's|/|.|g' | sed 's|.py||g' | tr '\n' ' ')

        if pytest --co -q $MODULES 2>/dev/null | grep -q "test_"; then
            TEST_START=$(date +%s)

            if pytest \
                --cov=. \
                --cov-fail-under=75 \
                --cov-report=term-missing:skip-covered \
                --maxfail=3 \
                --tb=short \
                --timeout=10 \
                -x \
                $MODULES 2>&1 | tee /tmp/pytest_output.log
            then
                TEST_END=$(date +%s)
                TEST_DURATION=$((TEST_END - TEST_START))
                echo -e "${GREEN}✓ Tests passed with ≥75% coverage (${TEST_DURATION}s)${NC}"
                echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"tests_passed\",\"duration_seconds\":$TEST_DURATION,\"modules\":\"$MODULES\"}" >> "$TEST_LOG"
                CHECKS_PASSED=$((CHECKS_PASSED + 1))
            else
                echo -e "${RED}❌ Tests failed or coverage <75%${NC}"
                echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"tests_failed\",\"modules\":\"$MODULES\",\"severity\":\"HIGH\"}" >> "$TEST_LOG"
                exit 1
            fi
        else
            echo -e "${YELLOW}⚠ No tests found for modules: $MODULES${NC}"
            CHECKS_PASSED=$((CHECKS_PASSED + 1))
        fi
    fi
fi

# ============================================
# PHASE 7: PROTECTED SURFACES VALIDATION
# ============================================

echo -e "\n${YELLOW}[GATE 7/9]${NC} PROTECTED SURFACES CHECK"

PROTECTED_SURFACES=(
    "orchestration/websocket_orchestrator.py"
    "memory/substrate_service.py"
    "core/kernel_loader.py"
    "docker-compose.yml"
    "core/packet.py"
    "core/auth.py"
)

PROTECTED_VIOLATIONS=0

for file in $(git diff --cached --name-only); do
    for protected in "${PROTECTED_SURFACES[@]}"; do
        if [[ "$file" == "$protected" ]]; then
            echo "   🔐 Validating protected surface: $file"

            # WebSocket orchestrator checks
            if [[ "$file" == *websocket_orchestrator* ]]; then
                if ! grep -q "def verify_ws_token\|def.*token.*verify" "$file"; then
                    echo "      ❌ Missing verify_ws_token() function"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
                if grep -E "SECRET|API_KEY|PASSWORD" "$file" | grep -v "# " | grep -q "="; then
                    echo "      ❌ Hardcoded credentials detected"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
                if grep -q "websocket.recv\|websocket.send" "$file" && ! grep -q "validate_message\|PacketEnvelope" "$file"; then
                    echo "      ❌ WebSocket messages not schema-validated"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
            fi

            # Substrate service checks
            if [[ "$file" == *substrate_service* ]]; then
                if grep -qE "SELECT|INSERT|UPDATE|DELETE" "$file" && ! grep -q "?\|placeholder\|parameterized" "$file"; then
                    echo "      ❌ Potential SQL injection (non-parameterized)"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
                if grep -qE "postgres://|mongodb://|redis://" "$file"; then
                    echo "      ❌ Connection strings must not be hardcoded"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
            fi

            # Kernel loader checks
            if [[ "$file" == *kernel_loader* ]]; then
                if grep -q "__import__\|importlib.import_module" "$file" && ! grep -q "validate_import_path\|kernel_registry\|safe_import" "$file"; then
                    echo "      ❌ Unsafe dynamic imports detected"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
                if grep -qE "^[^#]*(eval|exec|compile)\(" "$file"; then
                    echo "      ❌ Unsafe code execution (eval/exec) detected"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
            fi

            # Docker-compose checks
            if [[ "$file" == *docker-compose* ]]; then
                if grep -qE "password:|POSTGRES_PASSWORD|MYSQL_ROOT_PASSWORD" "$file" && ! grep -q ".env" "$file"; then
                    echo "      ❌ Hardcoded passwords in docker-compose"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
            fi

            # Packet protocol checks
            if [[ "$file" == */packet.py ]]; then
                if grep -q "class PacketEnvelope" "$file" && ! grep -qE ": str|: int|: dict|: List|: Optional" "$file"; then
                    echo "      ❌ PacketEnvelope missing type hints"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
            fi

            # Auth layer checks
            if [[ "$file" == */auth.py ]]; then
                if grep -E "password\s*=|password:" "$file" | grep -v "hash\|bcrypt" > /dev/null; then
                    echo "      ❌ Plaintext password in auth layer"
                    PROTECTED_VIOLATIONS=$((PROTECTED_VIOLATIONS + 1))
                fi
            fi
        fi
    done
done

if [ $PROTECTED_VIOLATIONS -gt 0 ]; then
    echo -e "${RED}❌ Found $PROTECTED_VIOLATIONS violations in protected surfaces${NC}"
    echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"protected_surface_violations\",\"count\":$PROTECTED_VIOLATIONS,\"severity\":\"CRITICAL\"}" >> "$HOOK_AUDIT_LOG"
    exit 1
fi

echo -e "${GREEN}✓ Protected surfaces validated${NC}"
CHECKS_PASSED=$((CHECKS_PASSED + 1))

# ============================================
# PHASE 8: ANTI-PATTERN DETECTION
# ============================================

echo -e "\n${YELLOW}[GATE 8/9]${NC} ANTI-PATTERN DETECTION"

ANTI_PATTERN_VIOLATIONS=0

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files staged, skipping anti-pattern checks${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    # Check for hardcoded /Users/ib-mac paths
    echo "  Checking for hardcoded user paths..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip test files and legacy scripts
            if [[ "$file" == tests/* ]] || [[ "$file" == scripts/* ]] || [[ "$file" == agents/cursor/* ]]; then
                continue
            fi

            if grep -q "/Users/ib-mac" "$file"; then
                echo -e "  ${RED}❌ CRITICAL: Hardcoded /Users/ib-mac path in $file${NC}"
                echo "     Fix: Use Path.home() or environment variables"
                ANTI_PATTERN_VIOLATIONS=$((ANTI_PATTERN_VIOLATIONS + 1))
            fi
        fi
    done

    if [ $ANTI_PATTERN_VIOLATIONS -gt 0 ]; then
        echo -e "${RED}❌ Anti-pattern check FAILED: $ANTI_PATTERN_VIOLATIONS violation(s)${NC}"
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"anti_pattern_violations\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"violations\":$ANTI_PATTERN_VIOLATIONS,\"severity\":\"CRITICAL\"}" >> "$HOOK_AUDIT_LOG"
        exit 1
    fi

    echo -e "${GREEN}✓ No anti-pattern violations detected${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# ============================================
# PHASE 9: ADR ENFORCEMENT (CRITICAL PATTERNS)
# ============================================

echo -e "\n${YELLOW}[GATE 9/10]${NC} ADR ENFORCEMENT (Critical Patterns)"

ADR_VIOLATIONS=0

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files staged, skipping ADR checks${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
    # ADR-0083: No datetime.utcnow() (deprecated)
    echo "  Checking ADR-0083: datetime.utcnow()..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip the ADR checker itself (contains patterns as strings)
            if [[ "$file" == "ci/check_adr_compliance.py" ]]; then continue; fi
            if grep -n "\.utcnow()" "$file" 2>/dev/null | grep -v "# noqa"; then
                echo -e "  ${RED}❌ ADR-0083: datetime.utcnow() in $file${NC}"
                echo "     Fix: Use datetime.now(UTC) instead"
                ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
            fi
        fi
    done

    # ADR-0088: No pickle (security)
    echo "  Checking ADR-0088: pickle usage..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip the ADR checker itself (contains patterns as strings)
            if [[ "$file" == "ci/check_adr_compliance.py" ]]; then continue; fi
            if grep -n "pickle\.load" "$file" 2>/dev/null | grep -v "# noqa"; then
                echo -e "  ${RED}❌ ADR-0088: pickle in $file${NC}"
                echo "     Fix: Use json.loads() or msgpack instead"
                ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
            fi
        fi
    done

    # ADR-0041: No eval/exec (security)
    echo "  Checking ADR-0041: eval/exec usage..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip allowed files (CI, tools, scripts, symbolic computation code generator)
            if [[ "$file" == ci/* ]] || [[ "$file" == tools/* ]] || [[ "$file" == scripts/* ]] || [[ "$file" == services/symbolic_computation/* ]]; then
                continue
            fi
            if grep -nE "^[^#]*\beval\s*\(|^[^#]*\bexec\s*\(" "$file" 2>/dev/null | grep -v "# noqa" | grep -v "\.eval(" > /dev/null; then
                echo -e "  ${RED}❌ ADR-0041: eval/exec in $file${NC}"
                echo "     Fix: Use ast.literal_eval() for safe parsing"
                ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
            fi
        fi
    done

    # ADR-0087: No f-string SQL (injection risk)
    echo "  Checking ADR-0087: f-string SQL..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            if grep -nE 'f"(SELECT|INSERT|UPDATE|DELETE).*\{' "$file" 2>/dev/null | grep -v "# noqa"; then
                echo -e "  ${RED}❌ ADR-0087: f-string SQL in $file${NC}"
                echo "     Fix: Use parameterized queries or add # noqa: ADR-0087"
                ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
            fi
        fi
    done

    # ADR-0019: No print() in production code
    echo "  Checking ADR-0019: print() usage..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip allowed directories (CI tools, scripts, CLI tools, MCP, agents)
            if [[ "$file" == ci/* ]] || [[ "$file" == scripts/* ]] || [[ "$file" == tools/* ]] || [[ "$file" == *__main__.py ]] || [[ "$file" == mcp_memory/* ]] || [[ "$file" == agents/cursor/* ]] || [[ "$file" == workflows/* ]]; then
                continue
            fi
            if grep -n "^\s*print(" "$file" 2>/dev/null | grep -v "# noqa" > /dev/null; then
                echo -e "  ${RED}❌ ADR-0019: print() in $file${NC}"
                echo "     Fix: Use structlog.get_logger() or add # noqa: ADR-0019"
                ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
            fi
        fi
    done

    # ADR-0019: No stdlib logging module
    echo "  Checking ADR-0019: logging module..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip allowed directories
            if [[ "$file" == ci/* ]] || [[ "$file" == scripts/* ]] || [[ "$file" == config/logging* ]] || [[ "$file" == core/observability/* ]]; then
                continue
            fi
            if grep -nE "^import logging$|^from logging import" "$file" 2>/dev/null | grep -v "# noqa" > /dev/null; then
                echo -e "  ${RED}❌ ADR-0019: stdlib logging in $file${NC}"
                echo "     Fix: Use structlog instead"
                ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
            fi
        fi
    done

    # ADR-0002: TYPE_CHECKING requires __future__ annotations
    echo "  Checking ADR-0002: TYPE_CHECKING pattern..."
    for file in $STAGED_PY_FILES; do
        if [ -f "$file" ]; then
            # Skip the ADR checker itself (contains patterns as strings)
            if [[ "$file" == "ci/check_adr_compliance.py" ]]; then continue; fi
            if grep -q "^\s*if TYPE_CHECKING:" "$file" 2>/dev/null; then
                if ! grep -q "from __future__ import annotations" "$file"; then
                    echo -e "  ${RED}❌ ADR-0002: TYPE_CHECKING without __future__ in $file${NC}"
                    echo "     Fix: Add 'from __future__ import annotations' at top"
                    ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
                fi
            fi
            # Check if TYPE_CHECKING is imported but not used in a guard
            if grep -qE "^\s*from typing import.*TYPE_CHECKING" "$file" 2>/dev/null; then
                # Ensure it's not actually used in 'if TYPE_CHECKING:'
                if ! grep -q "^\s*if TYPE_CHECKING:" "$file"; then
                    echo -e "  ${RED}❌ ADR-0002: TYPE_CHECKING imported but not used in a guard in $file${NC}"
                    echo "     Fix: Wrap type-only imports in 'if TYPE_CHECKING:' block"
                    ADR_VIOLATIONS=$((ADR_VIOLATIONS + 1))
                fi
            fi
        fi
    done

    if [ $ADR_VIOLATIONS -gt 0 ]; then
        echo -e "${RED}❌ Found $ADR_VIOLATIONS ADR violations${NC}"
        echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"adr_violations\",\"count\":$ADR_VIOLATIONS,\"severity\":\"CRITICAL\"}" >> "$HOOK_AUDIT_LOG"
        exit 1
    fi

    echo -e "${GREEN}✓ ADR enforcement passed (no critical violations)${NC}"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# ============================================
# PHASE 10: AUDIT TRAIL & METRICS
# ============================================

echo -e "\n${YELLOW}[GATE 10/10]${NC} AUDIT LOGGING & METRICS"

HOOK_END=$(date +%s)
HOOK_DURATION=$((HOOK_END - HOOK_START))

# Log overall execution
echo "{\"timestamp\":\"$(date -Iseconds)\",\"event\":\"precommit_success\",\"branch\":\"$BRANCH\",\"user\":\"$USER\",\"checks_passed\":$CHECKS_PASSED,\"total_checks\":$TOTAL_CHECKS,\"duration_seconds\":$HOOK_DURATION,\"staged_files\":$(echo $STAGED_PY_FILES | wc -w)}" >> "$HOOK_AUDIT_LOG"

# Export Prometheus metrics (optional - fails gracefully)
if command -v curl &>/dev/null; then
    PROMETHEUS_PG="${PROMETHEUS_PUSHGATEWAY:-http://localhost:9091}"
    (cat << EOF | curl -s -X POST --data-binary @- "$PROMETHEUS_PG/metrics/job/l9_precommit/instance/$BRANCH" 2>/dev/null
# TYPE l9_precommit_duration_seconds gauge
l9_precommit_duration_seconds{branch="$BRANCH",user="$USER"} $HOOK_DURATION
# TYPE l9_precommit_checks_passed gauge
l9_precommit_checks_passed{branch="$BRANCH"} $CHECKS_PASSED
EOF
    ) &
fi

echo -e "${GREEN}✓ Audit trail logged to: $HOOK_AUDIT_LOG${NC}"
echo -e "${GREEN}✓ AI security log: $AI_SEC_LOG${NC}"
echo -e "${GREEN}✓ Test results: $TEST_LOG${NC}"

# ============================================
# SUCCESS
# ============================================

echo ""
echo -e "${GREEN}✅ ALL GATES PASSED ($CHECKS_PASSED/$TOTAL_CHECKS)${NC}"
echo -e "Duration: ${GREEN}${HOOK_DURATION}s${NC}"
echo "=========================================="
echo "Commit ready for push to $BRANCH"
exit 0
