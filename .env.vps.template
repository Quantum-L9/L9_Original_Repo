# =============================================================================
# L9 DOCKER/VPS Environment (.env.example)
# For Docker Compose - uses service DNS names (NOT localhost!)
# Copy to .env and fill in actual values
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
MEMORY_DSN=postgresql://postgres:your_postgres_password_here@l9-postgres:5432/l9_memory
DATABASE_URL=postgresql://postgres:your_postgres_password_here@l9-postgres:5432/l9_memory

# Postgres container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=l9_memory

# Graph DB
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL RLS Context
RLS_TENANT_ID=l9
RLS_ORG_ID=quantumai
RLS_USER_ID=

# MCP Memory Server
MCP_API_KEY=your_mcp_api_key_here
MCP_ENABLED=

# =============================================================================
# API Keys
# =============================================================================
L9_EXECUTOR_API_KEY=your_executor_api_key_here
L9_API_KEY=your_l9_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=
PERPLEXITY_API_KEY=your_perplexity_api_key_here
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here
GMAIL_API_KEY=your_gmail_api_key_here
GPG_KEY=your_gpg_key_here

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MEMORY_API_PORT=8080
MEMORY_API_BASE_URL=http://l9-memory-api:8080

# =============================================================================
# Deployment
# =============================================================================
LOCAL_DEV=false
DOMAIN=l9.quantumaipartners.com
VPS_IP=46.62.243.82

# =============================================================================
# Slack Integration
# =============================================================================
SLACK_APP_ENABLED=true
SLACK_APP_ID=your_slack_app_id_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_VERIFICATION_TOKEN=your_slack_verification_token_here
SLACK_BOT_USER_ID=your_slack_bot_user_id_here
L_SLACK_USER_ID=your_slack_user_id_here

# =============================================================================
# Twilio Integration
# =============================================================================
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_NUMBER=your_twilio_sms_number_here
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number_here

# =============================================================================
# Agent Identity Configuration
# =============================================================================

# L (CTO Agent) Identity
L9_TENANT_ID=l-cto
L_CTO_USER_ID=l-cto
MCP_API_KEY_L=your_mcp_api_key_l_here

# Cursor IDE Identity
CURSOR_TENANT_ID=cursor-ide
CURSOR_USER_ID=cursor-ide
MCP_API_KEY_C=your_mcp_api_key_c_here

# =============================================================================
# Observability
# =============================================================================
PROMETHEUS_PORT=
GRAFANA_USER=
GRAFANA_PASSWORD=
GRAFANA_PORT=
JAEGER_UI_PORT=
JAEGER_COLLECTOR_PORT=

# =============================================================================
# Governance
# =============================================================================
GOVERNANCE_HARDENING_ENABLED=True
GOVERNANCE_ENFORCEMENT_MODE=log_only

# =============================================================================
# Feature Flags (L9 Prefix)
# =============================================================================
# Observability
L9_OBSERVABILITY=true
CALENDAR_ADAPTER_ENABLED=

# Routing
L9_ENABLE_LEGACY_SLACK_ROUTER=false

# Graph & Knowledge Integration
L9_GRAPH_AGENT_STATE=true
L9_GRAPH_WM_SYNC=true
L9_WM_GRAPH_SYNC=true
L9_TOOL_PATTERN_EXTRACTION=true

# Agent Initialization
L9_USE_KERNELS=true
L9_NEW_AGENT_INIT=true
L9_STAGE3_MODULES=true
L9_STAGE4_CONSOLIDATION=true
L9_CONSOLIDATION_INTERVAL_HOURS=4
L9_SKIP_STARTUP_CHECKS=false

# Email Agent (Gmail Multi-Account)
EMAIL_AGENT_ENABLED=true
L9_EMAIL_MULTI_ACCOUNT=true

# =============================================================================
# Integration Toggles
# =============================================================================
MAC_AGENT_ENABLED=true
EMAIL_ENABLED=false
INBOX_PARSER_ENABLED=false
WABA_ENABLED=false

# =============================================================================
# AI PR Review System
# =============================================================================
GEMINI_API_KEY=
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# =============================================================================
# Igor Owner Authentication
# =============================================================================
IGOR_SLACK_USER_ID=
L_CTO_GOVERNANCE_BYPASS=false
