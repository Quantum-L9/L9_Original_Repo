# =============================================================================
# L9 DOCKER/VPS Environment (.env.example)
# For Docker Compose - uses service DNS names (NOT localhost!)
# Copy to .env and fill in actual values
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
MEMORY_DSN=postgresql://postgres:YOUR_PASSWORD@host.docker.internal:5432/l9_memory
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@host.docker.internal:5432/l9_memory

# Postgres container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=l9_memory

# Graph DB
NEO4J_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_NEO4J_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# PostgreSQL RLS Context
RLS_TENANT_ID=l9
RLS_ORG_ID=quantumai
RLS_USER_ID=l9-shared

# MCP Memory Server
MCP_API_KEY=your_mcp_api_key
MCP_ENABLED=true

# =============================================================================
# API Keys
# =============================================================================
L9_EXECUTOR_API_KEY=your_executor_api_key
L9_API_KEY=your_l9_api_key
OPENAI_API_KEY=sk-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4o
PERPLEXITY_API_KEY=pplx-YOUR_KEY_HERE
GOOGLE_CALENDAR_API_KEY=replace_me
GMAIL_API_KEY=replace_me
GPG_KEY=replace_me

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MEMORY_API_PORT=8080
MEMORY_API_BASE_URL=http://l9-memory-api:8080

# =============================================================================
# Deployment
# =============================================================================
LOCAL_DEV=false
DOMAIN=your-domain.com
VPS_IP=0.0.0.0

# =============================================================================
# Slack Integration
# =============================================================================
SLACK_APP_ENABLED=false
SLACK_APP_ID=replace_me
SLACK_SIGNING_SECRET=replace_me
SLACK_CLIENT_SECRET=replace_me
SLACK_CLIENT_ID=replace_me
SLACK_BOT_TOKEN=xoxb-replace_me
SLACK_VERIFICATION_TOKEN=replace_me
SLACK_BOT_USER_ID=replace_me
L_SLACK_USER_ID=replace_me

# =============================================================================
# Twilio Integration
# =============================================================================
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_SMS_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# =============================================================================
# Agent Identity Configuration
# =============================================================================

# L (CTO Agent) Identity
L9_TENANT_ID=l-cto
L_CTO_USER_ID=l-cto
MCP_API_KEY_L=your_l_agent_mcp_key

# Cursor IDE Identity
CURSOR_TENANT_ID=cursor-ide
CURSOR_USER_ID=cursor-ide
MCP_API_KEY_C=your_cursor_mcp_key

# =============================================================================
# Observability
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268

# =============================================================================
# Governance
# =============================================================================
GOVERNANCE_HARDENING_ENABLED=True
GOVERNANCE_ENFORCEMENT_MODE=log_only

# =============================================================================
# Feature Flags (L9 Prefix)
# =============================================================================
# Observability
L9_OBSERVABILITY=true
CALENDAR_ADAPTER_ENABLED=false

# Routing
L9_ENABLE_LEGACY_SLACK_ROUTER=false

# Graph & Knowledge Integration
L9_GRAPH_AGENT_STATE=true
L9_GRAPH_WM_SYNC=true
L9_WM_GRAPH_SYNC=true
L9_TOOL_PATTERN_EXTRACTION=true

# Agent Initialization
L9_USE_KERNELS=true
L9_NEW_AGENT_INIT=true
L9_STAGE3_MODULES=true
L9_STAGE4_CONSOLIDATION=true
L9_CONSOLIDATION_INTERVAL_HOURS=4
L9_SKIP_STARTUP_CHECKS=false

# Email Agent (Gmail Multi-Account)
EMAIL_AGENT_ENABLED=false
L9_EMAIL_MULTI_ACCOUNT=true

# =============================================================================
# Integration Toggles
# =============================================================================
MAC_AGENT_ENABLED=true
EMAIL_ENABLED=false
INBOX_PARSER_ENABLED=false
WABA_ENABLED=false

# =============================================================================
# AI PR Review System
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# =============================================================================
# Igor Owner Authentication
# =============================================================================
IGOR_SLACK_USER_ID=your_slack_member_id
L_CTO_GOVERNANCE_BYPASS=false
