# =============================================================================
# L9 Environment Template (.env.example)
# NO SECRETS - Copy to .env and fill in real values
# Last updated: 2026-01-14
# =============================================================================

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
MEMORY_DSN=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/l9_memory
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/l9_memory
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=l9_memory

# -----------------------------------------------------------------------------
# OpenAI (REQUIRED for embeddings and LLM)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-YOUR_KEY_HERE
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Embedding Configuration
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# MCP Memory Configuration
# -----------------------------------------------------------------------------
MCP_API_KEY=replace_me
MCP_API_KEY_C=your_cursor_mcp_key
MCP_API_KEY_L=your_l_agent_mcp_key
MCP_L9_MEMORY_KEY=replace_me
MCP_ENABLED=true
MEMORY_API_PORT=8080
MEMORY_API_BASE_URL=http://l9-memory-api:8080

# -----------------------------------------------------------------------------
# L9 API Keys (generate with: openssl rand -hex 32)
# -----------------------------------------------------------------------------
L9_API_KEY=replace_me
L9_EXECUTOR_API_KEY=replace_me

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
PERPLEXITY_API_KEY=replace_me
GOOGLE_CALENDAR_API_KEY=replace_me
GMAIL_API_KEY=replace_me
GPG_KEY=replace_me

# Neo4j Graph Database
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=YOUR_PASSWORD

# Redis (for rate limiting, caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Qdrant Vector DB (optional, pgvector preferred)
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Agent Identity Configuration
# -----------------------------------------------------------------------------
# L (CTO Agent) Identity
L9_TENANT_ID=l-cto
L_CTO_USER_ID=l-cto

# Cursor IDE Identity
CURSOR_TENANT_ID=cursor-ide
CURSOR_USER_ID=cursor-ide

# PostgreSQL RLS Context (GMP-80: deterministic UUIDs)
# These string identifiers are converted to UUIDs via uuid5 for PostgreSQL RLS.
# L and C share the same tenant/org/user to preserve collaboration.
RLS_TENANT_ID=l9
RLS_ORG_ID=quantumai
RLS_USER_ID=l9-shared
# -----------------------------------------------------------------------------
# Deployment Configuration
# -----------------------------------------------------------------------------
LOCAL_DEV=false
DOMAIN=your-domain.com
VPS_IP=0.0.0.0

# -----------------------------------------------------------------------------
# Slack Integration
# -----------------------------------------------------------------------------
SLACK_APP_ENABLED=false
SLACK_APP_ID=replace_me
SLACK_SIGNING_SECRET=replace_me
SLACK_CLIENT_SECRET=replace_me
SLACK_CLIENT_ID=replace_me
SLACK_BOT_TOKEN=xoxb-replace_me
SLACK_VERIFICATION_TOKEN=replace_me
SLACK_BOT_USER_ID=replace_me
L_SLACK_USER_ID=replace_me

# -----------------------------------------------------------------------------
# Twilio Integration
# -----------------------------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=replace_me
TWILIO_AUTH_TOKEN=replace_me
TWILIO_SMS_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Email Integration
# -----------------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_AGENT_ENABLED=true
L9_EMAIL_MULTI_ACCOUNT=true

# -----------------------------------------------------------------------------
# Observability (Prometheus, Grafana, Jaeger)
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
JAEGER_COLLECTOR_PORT=14268

# -----------------------------------------------------------------------------
# Integration Toggles
# -----------------------------------------------------------------------------
MAC_AGENT_ENABLED=true
WABA_ENABLED=false
CALENDAR_ADAPTER_ENABLED=false
INBOX_PARSER_ENABLED=false

# -----------------------------------------------------------------------------
# API Server Configuration
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Feature Flags (L9 System)
# -----------------------------------------------------------------------------
L9_OBSERVABILITY=true
L9_ENABLE_LEGACY_SLACK_ROUTER=false
L9_GRAPH_AGENT_STATE=true
L9_GRAPH_WM_SYNC=true
L9_WM_GRAPH_SYNC=true
L9_TOOL_PATTERN_EXTRACTION=true
L9_USE_KERNELS=true
L9_NEW_AGENT_INIT=true
L9_STAGE3_MODULES=true
L9_STAGE4_CONSOLIDATION=true
L9_CONSOLIDATION_INTERVAL_HOURS=4

# =============================================================================
# DO NOT COMMIT REAL SECRETS
# Copy this file to .env and fill in values locally or on VPS
# =============================================================================

# -----------------------------------------------------------------------------
# Governance (Memory Operations)
# -----------------------------------------------------------------------------
GOVERNANCE_HARDENING_ENABLED=True
GOVERNANCE_ENFORCEMENT_MODE=log_only
